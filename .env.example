# ===========================================
# AMATIS - Environment Configuration
# ===========================================

# Application
NODE_ENV=development
APP_NAME=AMATIS
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
TIMEZONE=Asia/Tehran

# Database
DATABASE_URL=postgresql://amatis:amatis_secret@localhost:5050/amatis?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=amatis
MINIO_SECRET_KEY=amatis_secret
MINIO_BUCKET=amatis-files
MINIO_USE_SSL=false

# Security
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Demo Accounts (Development Only - NEVER use in production)
# Admin:     09120000001 / Admin@123456
# Executive: 09120000002 / Executive@123456
# Supervisor:09120000003 / Supervisor@123456
# Employee:  09120000004 /      Employee@123456        ÷÷
